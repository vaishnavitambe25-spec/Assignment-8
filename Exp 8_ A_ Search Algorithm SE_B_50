{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOwJGaGxIniHGtyc3oN7tnw"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["from queue import PriorityQueue\n","\n","def a_star_search(graph, start, goal, h):\n","  open_set = PriorityQueue()\n","  open_set.put((0, start))\n","\n","  g_score = {node: float(\"inf\") for node in graph}\n","  g_score[start] = 0\n","\n","  came_from = {}\n","  while not open_set.empty():\n","    current_f, current = open_set.get()\n","\n","    if current == goal:\n","      path = []\n","      while current in came_from:\n","        path.append(current)\n","        current = came_from[current]\n","      path.append(start)\n","      path.reverse()\n","      return path, g_score[goal]\n","\n","    for neighbor, cost in graph[current]:\n","      new_cost = g_score[current] + cost\n","\n","      if new_cost < g_score[neighbor]:\n","        g_score[neighbor] = new_cost\n","        came_from[neighbor] = current\n","        priority = new_cost + h(neighbor)\n","        open_set.put((priority, neighbor))\n","\n","\n","  return None, float('inf')\n","\n","graph = {\n","    'A': [('B', 1), ('C', 4)],\n","    'B': [('A', 1), ('C', 2), ('D', 5)],\n","    'C': [('A', 4), ('B', 2), ('D', 1)],\n","    'D': [('B', 5), ('C', 1)]\n","}\n","\n","heuristic = {\n","    'A': 7,\n","    'B': 6,\n","    'C': 2,\n","    'D': 0\n","}\n","\n","def h(node):\n","    return heuristic[node]\n","\n","path, cost = a_star_search(graph, 'A', 'D', h)\n","\n","print(\"Path:\", path)\n","print(\"Cost:\", cost)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1789014162297,"user_tz":-330,"elapsed":10,"user":{"displayName":"Vaishnavi Tambe","userId":"03784812411840822427"}},"outputId":"e4db6d6b-570c-4b43-8d64-2a5faf4707d1","id":"jzUg9Q4BjL9k"},"execution_count":14,"outputs":[{"output_type":"stream"